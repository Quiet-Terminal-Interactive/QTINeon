{
  "name": "qti-neon",
  "version": "1.2.0",
  "description": "Minimal, game-agnostic, relay-based UDP multiplayer protocol library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "docs": "typedoc src/index.ts --tsconfig tsconfig.typedoc.json --out ../docs/ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublish": "npm run build"
  },
  "keywords": ["udp", "relay", "multiplayer", "game", "networking", "dtls"],
  "author": "Kohan Mathers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quiet-Terminal-Interactive/QTINeon"
  },
  "optionalDependencies": {
    "koffi": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typedoc": "^0.27.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
